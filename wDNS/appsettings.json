{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Listening": {
    "IPAddress": "127.0.0.1",
    "Port": 53,

    "ServiceType": "wDNS.Listening.UdpListener",

    // DEBUG: buffer printing
    "PrintBytesOnReceive": false,
    "PrintRequestOnProcess": false
  },
  "Forwarding": {
    "Ports": [
      49152,
      60999
    ],
    "Remotes": [
      "$default-gateway"
    ],
    "Timeout": 3000,

    // DEBUG: buffer printing
    "PrintQueryBytesOnReceiveError": false,
    "PrintRequestBytesOnSending": false,
    "PrintResponseOnReceive": false,
    "PrintResponseBytesOnReceive": false,
    "PrintResponseBytesOnReceiveError": false
  },
  "SuppressWarnings": {
    "UDPConnectionReset": "true"
  }
}
